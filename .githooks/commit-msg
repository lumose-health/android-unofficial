#!/bin/bash
# Local commit-msg hook, two jobs in one file (git only runs one commit-msg
# hook, so both of this repo's commit-message policies live here instead of
# two separate scripts):
#
# 1. Strips AI tool co-author attribution from commit messages, ported from
#    the platform monorepo's scripts/hooks/commit-msg. Covers all known AI
#    coding tools. Portable across macOS and Linux.
# 2. Warns (non-blocking) if the commit has no DCO Signed-off-by trailer --
#    once the DCO GitHub App is installed (configured via .github/dco.yml),
#    it will be the authoritative, server-side enforcement and will block
#    any PR containing an unsigned commit, regardless of whether this hook
#    is installed.
#
# Install: cp .githooks/commit-msg .git/hooks/commit-msg && chmod +x .git/hooks/commit-msg
# (Or point Git at this directory directly: git config core.hooksPath .githooks)

MSG_FILE="$1"
if [ ! -f "$MSG_FILE" ]; then
    exit 0
fi

# --- Job 1: strip AI attribution trailers ---
# AI tool names (kept in sync with the platform monorepo's attribution-check
# workflow; this repo's own server-side attribution gate is added in a later
# CI stage -- until then this local hook is the attribution guard)
# Uses character-class case handling because sed -E doesn't support -i flag
# for case-insensitive matching portably across macOS/Linux.
AI_TOOLS="[Cc]laude|[Aa]nthropic|[Cc]opilot|[Cc]hat[Gg][Pp][Tt]|[Oo]pen[Aa][Ii]|[Cc]ursor|[Ww]indsurf|[Cc]odeium|[Cc]ode[Ww]hisperer|[Aa]mazon\.[Qq]|[Gg]emini|[Jj]et[Bb]rains\.[Aa][Ii]|[Tt]abnine|[Ss]ourcegraph|[Cc]ody|[Dd]evin|[Aa]ider|[Cc]odex|\\[bot\\]|noreply@"

# Strip Co-Authored-By lines referencing AI tools (-E for extended regex)
sed -E -i.bak "/^Co-[Aa]uthored-[Bb]y:.*(${AI_TOOLS})/d" "$MSG_FILE" && rm -f "$MSG_FILE.bak"

# Strip alternative attribution trailer formats
sed -E -i.bak '/^([Aa]uthored-[Bb]y:|[Gg]enerated-[Bb]y:|AI-[Gg]enerated-[Bb]y:)/d' "$MSG_FILE" && rm -f "$MSG_FILE.bak"

# Remove trailing blank lines left by the strips above (portable -- perl
# ships with macOS, Linux, and Git)
perl -0777 -pi -e 's/\n{2,}\z/\n/' "$MSG_FILE"

# --- Job 2: warn on a missing DCO Signed-off-by trailer ---
if ! grep -qE '^Signed-off-by: .+ <.+@.+>$' "$MSG_FILE"; then
    echo "warning: this commit has no 'Signed-off-by:' trailer." >&2
    echo "         run 'git commit -s' (or 'git commit --amend -s --no-edit' to fix the last commit)." >&2
    echo "         the DCO check in CI will block the PR until every commit is signed off." >&2
fi

exit 0
